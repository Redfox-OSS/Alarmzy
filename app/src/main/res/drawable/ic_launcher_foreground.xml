<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: crimson alarm clock with a soft glow ("Obsidian glow", variant B1).
  Drawn on the design canvas, then scaled to 82% and nudged up so the bells stay inside the
  66dp adaptive-icon safe zone on every OEM mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <group android:translateY="-2">
            <!-- Glow -->
            <path android:pathData="M18,58a36,36 0 1,0 72,0a36,36 0 1,0 -72,0">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="54"
                        android:centerY="58"
                        android:gradientRadius="36">
                        <item android:offset="0" android:color="#59FF3B4E" />
                        <item android:offset="1" android:color="#00FF3B4E" />
                    </gradient>
                </aapt:attr>
            </path>
            <!-- Bells, aligned radially with the ring -->
            <group android:pivotX="54" android:pivotY="58" android:rotation="-42">
                <path
                    android:fillColor="#FFFF3B4E"
                    android:strokeColor="#FFFF3B4E"
                    android:strokeWidth="2"
                    android:strokeLineJoin="round"
                    android:pathData="M47,30.5A7,7 0 0,1 61,30.5Z" />
            </group>
            <group android:pivotX="54" android:pivotY="58" android:rotation="42">
                <path
                    android:fillColor="#FFFF3B4E"
                    android:strokeColor="#FFFF3B4E"
                    android:strokeWidth="2"
                    android:strokeLineJoin="round"
                    android:pathData="M47,30.5A7,7 0 0,1 61,30.5Z" />
            </group>
            <!-- Ring -->
            <path
                android:strokeColor="#FFFF3B4E"
                android:strokeWidth="5"
                android:pathData="M32,58a22,22 0 1,0 44,0a22,22 0 1,0 -44,0" />
            <!-- Hands + pivot -->
            <path
                android:strokeColor="#FFF5F5F7"
                android:strokeWidth="4"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M54,46V58L61.5,63" />
            <path
                android:fillColor="#FFF5F5F7"
                android:pathData="M51.4,58a2.6,2.6 0 1,0 5.2,0a2.6,2.6 0 1,0 -5.2,0" />
        </group>
    </group>
</vector>
